# Todo arquivo de texto é guardado no repositório com final de linha LF
* text=auto eol=lf

# Scripts do Windows precisam de CRLF para funcionar corretamente
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários: nunca converter e nunca comparar como texto
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
*.pdf binary
*.docx binary
*.zip binary
